rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // فيديوهات معاينة الكورسات — يرفعها المُفهم صاحب الكورس بس، وأي حد يقدر يشاهدها
    match /course-previews/{instructorId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == instructorId
                    && request.resource.size < 300 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');
    }

    // صور غلاف الكورسات
    match /course-covers/{instructorId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.uid == instructorId
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // باقي الملفات: افتراضيًا ممنوعة إلا لو مسجّل دخول (حماية أساسية)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
