
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isNotBlocked() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "blocked"
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().isAdmin == true ||
        request.auth.token.email == "mohamed76y@gmail.com"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // السماح للأدمن بكل شيء
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ملفات المستخدمين
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && (getUserData().status != "blocked" || isAdmin());

      match /transactions/{transactionId} {
        allow read: if isOwner(userId) && isNotBlocked();
        allow create: if isNotBlocked();
      }
    }

    // الطعون (Appeals)
    match /appeals/{appealId} {
      allow create: if isSignedIn(); // السماح للمحظور بتقديم طعن
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // الأقسام والتخصصات (متاحة للجميع للقراءة لملء النماذج)
    match /categories/{categoryId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // الاستفهامات (الطلبات)
    match /istifhams/{istifhamId} {
      allow create: if isNotBlocked();
      allow read: if isNotBlocked() && (
        resource.data.status == "active" ||
        resource.data.mustafhemId == request.auth.uid || 
        resource.data.mufhemId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isNotBlocked() && (
        resource.data.mustafhemId == request.auth.uid || 
        resource.data.mufhemId == request.auth.uid ||
        isAdmin()
      );
    }

    // الإشعارات
    match /notifications/{notificationId} {
      allow read: if isNotBlocked() && resource.data.userId == request.auth.uid;
      allow update: if isNotBlocked() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
    }

    // الإعدادات العامة
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
