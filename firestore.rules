rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // قواعد الطلبات العامة
    match /requests/{requestId} {
      // السماح بالقراءة والكتابة لكل المستخدمين المسجلين لضمان تدفق العمليات المالية والمشاركة
      allow read, write: if isSignedIn();
    }

    // قواعد بيانات المستخدمين
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      // العمليات المالية (المعاملات) - خاصة جداً لصاحب الحساب
      match /transactions/{transactionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn(); // السماح بإنشاء معاملات من النظام عند إكمال الجلسات
      }
    }
  }
}