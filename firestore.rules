rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة للتحقق من أن المستخدم مسجل دخول
    function isSignedIn() {
      return request.auth != null;
    }

    // قواعد مجموعة الطلبات العامة (Marketplace)
    // نستخدم {document=**} لضمان شمولية القواعد لكل العمليات والقوائم
    match /requests/{document=**} {
      // السماح بالقراءة (get/list) لكل المستخدمين المسجلين
      allow read: if isSignedIn();
      
      // السماح بإنشاء طلب جديد لأي مستخدم مسجل
      allow create: if isSignedIn();
      
      // السماح بالتحديث لأي مستخدم مسجل (لقبول الطلب)
      allow update: if isSignedIn();
      
      // المسح فقط لصاحب الطلب
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // قواعد ملفات المستخدمين
    match /users/{userId} {
      // السماح بالقراءة لأي مستخدم مسجل
      allow read: if isSignedIn();
      // الكتابة فقط لصاحب الحساب
      allow write: if isSignedIn() && request.auth.uid == userId;

      // العمليات المالية (المعاملات)
      match /transactions/{transactionId} {
        // الوصول فقط لصاحب الحساب
        allow read: if isSignedIn() && request.auth.uid == userId;
        // الكتابة فقط لصاحب الحساب
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}