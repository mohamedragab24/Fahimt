
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == "mohamed76y@gmail.com" || 
        request.auth.uid == "ee87e6bwIbaSb5JoVLl4dcrHAjn2"
      );
    }

    function isAdmin() {
      return request.auth != null && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /applications/{appId} {
        allow create: if true;
        allow read: if isAdmin();
      }
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid);
      }
    }

    match /floatingChats/{chatId} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/floatingChats/$(chatId)).data.userId == request.auth.uid);
      }
    }

    match /istifhams/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{id} { allow read, write: if isSignedIn(); }
    match /portfolio/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /appeals/{id} { allow create: if isSignedIn(); allow read, write: if isAdmin(); }
    match /adminLogs/{id} { allow read, write: if isAdmin(); }
    match /payoutRequests/{id} { allow read, write: if isAdmin(); }
  }
}
