rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // قواعد الطلبات
    match /requests/{requestId} {
      // السماح بالقراءة (get & list) لكل مستخدم مسجل دخول
      allow read: if isSignedIn();
      
      // السماح بالإنشاء لأي مستخدم مسجل
      allow create: if isSignedIn();
      
      // السماح بالتحديث (لقبول الطلب أو إكماله)
      allow update: if isSignedIn();
      
      // الحذف فقط لصاحب الطلب (الطالب)
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // قواعد المستخدمين
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      // قواعد المعاملات المالية داخل المستخدم
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        // السماح بالكتابة فقط إذا كان المستخدم هو صاحب الحساب (في MVP نعتمد على الكلاينت)
        allow write: if isOwner(userId);
      }
    }
  }
}