
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        request.auth.token.email == "mohamed76y@gmail.com"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // السماح للأدمن بكل شيء
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ملفات المستخدمين
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn();
      }
    }

    // الأقسام والتخصصات (متاحة للجميع للقراءة لملء النماذج)
    match /categories/{categoryId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // الاستفهامات (الطلبات)
    match /istifhams/{istifhamId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.status == "active" ||
        resource.data.mustafhemId == request.auth.uid || 
        resource.data.mufhemId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.mustafhemId == request.auth.uid || 
        resource.data.mufhemId == request.auth.uid ||
        isAdmin()
      );
    }

    // الإشعارات
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
    }

    // طلبات التوثيق
    match /verificationRequests/{verId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // طلبات السحب المالي
    match /payoutRequests/{payoutId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // الإعدادات العامة
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // سجلات الإدارة
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
