
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دالة للتحقق من تسجيل الدخول
    function isSignedIn() {
      return request.auth != null;
    }

    // دالة للتحقق من ملكية البيانات
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // قواعد ملفات المستخدمين
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      // قواعد العمليات المالية (المحفظة)
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // قواعد طلبات الاستفهام (Marketplace)
    match /requests/{requestId} {
      // السماح بالقراءة (get و list) لجميع المستخدمين المسجلين
      allow read: if isSignedIn();
      
      // السماح بالإنشاء فقط للطلاب المسجلين
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      
      // السماح بالتحديث لصاحب الطلب أو المعلم الذي يقبله
      allow update: if isSignedIn() && (
        // صاحب الطلب (المستفهم)
        (resource.data.studentId == request.auth.uid) ||
        // المعلم الذي يقبل الطلب (المفهم)
        (request.resource.data.teacherId == request.auth.uid) ||
        // المعلم الذي قبل الطلب مسبقاً
        (resource.data.teacherId == request.auth.uid)
      );
      
      // السماح بالحذف فقط لصاحب الطلب
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }
  }
}
