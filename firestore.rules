rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة مساعدة للتحقق من تسجيل الدخول
    function isSignedIn() {
      return request.auth != null;
    }

    // قواعد مجموعة الطلبات (Requests)
    match /requests/{requestId} {
      // السماح بالقراءة لكل مستخدم مسجل
      allow read: if isSignedIn();
      
      // السماح بالإنشاء للمستخدم المسجل
      allow create: if isSignedIn();
      
      // السماح بالتحديث لصاحب الطلب أو المدرس
      allow update: if isSignedIn();
      
      // السماح بالحذف لصاحب الطلب
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // قواعد ملفات المستخدمين (Users)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      // العمليات المالية (Transactions)
      match /transactions/{transactionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}