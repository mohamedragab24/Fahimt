
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /requests/{requestId} {
      // All signed in users can see requests (Marketplace)
      allow read: if isSignedIn();
      
      // Only students can create requests
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      
      // Students can update/delete their own pending requests
      // Teachers can update status to 'accepted' if they are the teacherId
      allow update: if isSignedIn() && (
        (request.resource.data.studentId == request.auth.uid) ||
        (request.resource.data.status == 'accepted' && request.resource.data.teacherId == request.auth.uid)
      );
      
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }
  }
}
