rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /requests/{requestId} {
      // الجميع يمكنه رؤية الطلبات المتاحة أو طلباته الخاصة
      allow read: if isSignedIn();
      
      // المستفهم فقط يمكنه الإنشاء
      allow create: if isSignedIn();
      
      // التحديث مسموح للمدرس لقبول الطلب أو لصاحب الطلب لتغيير الحالة
      allow update: if isSignedIn();
      
      // الحذف لصاحب الطلب فقط
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      match /transactions/{transactionId} {
        // القراءة لصاحب الحساب فقط، الكتابة مسموحة للنظام (بما أننا في MVP نعتمد على الكلاينت مع قواعد حذرة)
        allow read, write: if isOwner(userId);
      }
    }
  }
}