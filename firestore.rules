
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. صلاحيات المسؤول الماستر المطلقة (وصول كامل دون قيود)
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == "mohamed76y@gmail.com" || 
        request.auth.token.email == "mohamjedminijd2006@gmail.com" ||
        request.auth.uid == "ee87e6bwIbaSb5JoVLl4dcrHAjn2"
      );
    }

    // 2. التحقق مما إذا كان المستخدم مسؤولاً (سواء ماستر أو بقرار إداري)
    function isAdmin() {
      return request.auth != null && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotBlocked() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "blocked"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // السماح للمسؤول الماستر بكل شيء في أي مكان
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // ملفات المستخدمين
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if (isOwner(userId) || isAdmin()) && isNotBlocked();

      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isNotBlocked();
        allow update, delete: if isAdmin();
      }
    }

    // الاستفهامات (الطلبات)
    match /istifhams/{istifhamId} {
      allow create: if isNotBlocked();
      allow read: if true;
      allow update: if isNotBlocked() || isAdmin();
      allow delete: if isAdmin();
    }

    // الإعدادات العامة - مسموح لأي مسؤول بتغييرها
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // القواعد العامة للمجموعات الأخرى
    match /notifications/{id} { allow read, write: if isSignedIn(); }
    match /payoutRequests/{id} { allow read, write: if isAdmin(); }
    match /portfolio/{id} { allow read: if true; allow write: if isSignedIn(); }
    match /verificationRequests/{id} { allow read, write: if isAdmin(); }
    match /adminLogs/{id} { allow read, write: if isAdmin(); }
    match /supportTickets/{id} { allow read, write: if isSignedIn(); }
    match /appeals/{id} { allow read, write: if isSignedIn(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
