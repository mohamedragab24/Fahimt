
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // أي مستخدم مسجل يمكنه رؤية الملفات الشخصية (لأغراض العرض)
      allow read: if isSignedIn();
      // صاحب الحساب فقط يمكنه تعديل بياناته
      allow write: if isOwner(userId);

      match /transactions/{transactionId} {
        // المحفظة خاصة تماماً بصاحب الحساب
        allow read, write: if isOwner(userId);
      }
    }

    match /requests/{requestId} {
      // السماح بالقراءة (get و list) لجميع المستخدمين المسجلين لدعم سوق الطلبات (Marketplace)
      allow read: if isSignedIn();
      
      // الطلاب فقط يمكنهم إنشاء طلبات جديدة، ويجب أن يكونوا هم أصحاب الطلب
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      
      // التعديل مسموح في حالتين:
      // 1. الطالب صاحب الطلب (مثلاً لإلغائه أو تعديله)
      // 2. المعلم الذي قبل الطلب (لتغيير الحالة إلى 'accepted' أو 'completed')
      allow update: if isSignedIn() && (
        (request.resource.data.studentId == request.auth.uid) ||
        (request.resource.data.teacherId == request.auth.uid)
      );
      
      // الحذف مسموح فقط لصاحب الطلب
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }
  }
}
