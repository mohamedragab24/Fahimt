
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == "mohamed76y@gmail.com" || 
        request.auth.uid == "ee87e6bwIbaSb5JoVLl4dcrHAjn2" ||
        request.auth.token.email == "mohamjedminijd2006@gmail.com"
      );
    }

    function isAdmin() {
      return request.auth != null && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // قواعد عامة لكافة المجموعات للمسؤولين
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);

      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    match /jobs/{jobId} {
      allow read: if true;
      
      match /applications/{appId} {
        allow create: if true;
      }
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource == null || request.auth.uid == resource.data.userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());

      match /messages/{msgId} {
        allow read, create: if isSignedIn();
      }
    }

    match /floatingChats/{chatId} {
      allow create: if true;
      allow read: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (chatId == request.auth.uid || isAdmin());

      match /messages/{msgId} {
        allow read, create: if isSignedIn();
      }
    }

    match /istifhams/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isAdmin();

      match /offers/{offerId} {
        allow create: if isSignedIn();
        allow read: if true;
        allow update: if isSignedIn() || isAdmin();
      }
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /verificationRequests/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }
    
    match /notifications/{id} { 
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /portfolio/{id} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.mufhemId);
    }

    match /categories/{id} { 
      allow read: if true; 
      allow write: if isAdmin();
    }

    match /appeals/{id} { 
      allow create: if isSignedIn(); 
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /payoutRequests/{id} { 
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    match /direct_chats/{chatId} {
      allow read, update: if isAdmin() || (isSignedIn() && (request.auth.uid in resource.data.participants));
      allow create: if isSignedIn();

      match /messages/{msgId} {
        allow read, create: if isSignedIn();
      }
    }
  }
}
