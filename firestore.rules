rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // قواعد مجموعة الطلبات (Requests) - Marketplace
    match /requests/{requestId} {
      // السماح بالقراءة (get و list) لكل مستخدم مسجل دخول
      allow read: if request.auth != null;
      
      // السماح بالإنشاء فقط إذا كان المعرف الخاص بالطالب يطابق المستخدم المسجل
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      
      // السماح بالتحديث لصاحب الطلب أو المعلم الذي يقبله
      allow update: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        request.resource.data.teacherId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      
      // السماح بالحذف فقط لصاحب الطلب
      allow delete: if request.auth != null && resource.data.studentId == request.auth.uid;
    }

    // قواعد ملفات المستخدمين (Users)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // العمليات المالية الخاصة (Transactions)
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}