
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == "mohamed76y@gmail.com" || 
        request.auth.uid == "ee87e6bwIbaSb5JoVLl4dcrHAjn2" ||
        request.auth.token.email == "mohamjedminijd2006@gmail.com"
      );
    }

    function isAdmin() {
      return request.auth != null && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();

      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /applications/{appId} {
        allow create: if true;
        allow read: if isAdmin();
      }
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && (resource == null || request.auth.uid == resource.data.userId));
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, create: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid);
      }
    }

    match /floatingChats/{chatId} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && (chatId == request.auth.uid || (resource != null && request.auth.uid == resource.data.userId)));
      allow update: if isAdmin() || (isSignedIn() && chatId == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, create: if isAdmin() || (isSignedIn() && (chatId == request.auth.uid));
      }
    }

    match /istifhams/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      match /offers/{offerId} {
        allow create: if isSignedIn();
        allow read: if true;
        allow update: if isSignedIn();
      }
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /verificationRequests/{id} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }
    
    match /notifications/{id} { 
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /portfolio/{id} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.mufhemId);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.mufhemId);
    }

    match /categories/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /appeals/{id} { 
      allow create: if isSignedIn(); 
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /adminLogs/{id} { 
      allow read, write: if isAdmin(); 
    }

    match /payoutRequests/{id} { 
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    match /direct_chats/{chatId} {
      allow read, update: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow create: if isSignedIn();

      match /messages/{msgId} {
        allow read, create: if isAdmin() || (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants);
      }
    }
  }
}
