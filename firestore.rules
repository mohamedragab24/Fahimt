
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // السماح للأدمن بكل شيء
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn();
      }
    }

    match /categories/{categoryId} {
      allow read: if true; 
    }

    // الاستفهامات (الطلبات)
    match /istifhams/{istifhamId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.status == "active" ||
        resource.data.mustafhemId == request.auth.uid || 
        resource.data.mufhemId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.mustafhemId == request.auth.uid || 
        resource.data.mufhemId == request.auth.uid ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/istifhams/$(istifhamId)).data.mustafhemId == request.auth.uid ||
          get(/databases/$(database)/documents/istifhams/$(istifhamId)).data.mufhemId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // الإشعارات
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /payoutRequests/{payoutId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /verificationRequests/{verId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /settings/{settingId} {
      // السماح بقراءة الإعدادات العامة للجميع لعرض الهوية البصرية
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
