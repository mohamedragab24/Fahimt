rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // الطلبات التعليمية
    match /requests/{requestId} {
      // القراءة متاحة للجميع لتسهيل عمل المدرسين والبحث
      allow read: if isSignedIn();
      // الإنشاء للطالب فقط، والتحديث لأطراف الطلب
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // بيانات المستخدمين
    match /users/{userId} {
      // السماح بالقراءة للمعلمين والطلاب للتواصل (مثل الاسم والصورة والهاتف)
      allow read: if isSignedIn();
      // التعديل لصاحب الحساب فقط
      allow write: if isOwner(userId);

      // المعاملات المالية
      match /transactions/{transactionId} {
        // قراءة السجلات المالية متاحة فقط لصاحب الحساب
        allow read: if isOwner(userId);
        // الإنشاء متاح للنظام (المستخدمين) عند إكمال العمليات المالية
        allow create: if isSignedIn();
        allow update, delete: if false; // لا يمكن تعديل أو حذف المعاملات بعد تسجيلها
      }
    }
  }
}