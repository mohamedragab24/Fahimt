rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة للتحقق من أن المستخدم مسجل دخول
    function isSignedIn() {
      return request.auth != null;
    }

    // قواعد مجموعة الطلبات العامة (Marketplace)
    match /requests/{requestId} {
      // القراءة متاحة لكل مستخدم مسجل ليتمكن المعلمون من رؤية الطلبات والطلاب من متابعة طلباتهم
      allow read: if isSignedIn();
      
      // السماح بإنشاء طلب جديد لأي مستخدم مسجل
      allow create: if isSignedIn();
      
      // السماح بالتحديث لأي مستخدم مسجل (لقبول الطلب، إكماله، أو إلغائه)
      allow update: if isSignedIn();
      
      // الحذف فقط لصاحب الطلب
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // قواعد ملفات المستخدمين
    match /users/{userId} {
      // السماح بالقراءة لأي مستخدم مسجل (لرؤية ملفات المعلمين والطلاب عند التواصل)
      allow read: if isSignedIn();
      // الكتابة فقط لصاحب الحساب
      allow write: if isSignedIn() && request.auth.uid == userId;

      // العمليات المالية (المعاملات) - خاصة جداً
      match /transactions/{transactionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}