
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "mohamed76y@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isNotBlocked() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "blocked"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // السماح للأدمن بكل شيء في النظام
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ملفات المستخدمين
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && (isAdmin() || (exists(/databases/$(database)/documents/users/$(userId)) && get(/databases/$(database)/documents/users/$(userId)).data.status != "blocked"));

      match /transactions/{transactionId} {
        allow read: if isOwner(userId) && isNotBlocked();
        allow create: if isNotBlocked();
        allow update, delete: if isAdmin();
      }
    }

    // الطعون (Appeals)
    match /appeals/{appealId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // الأقسام والتخصصات
    match /categories/{categoryId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // الاستفهامات (الطلبات)
    match /istifhams/{istifhamId} {
      allow create: if isNotBlocked();
      allow read: if isNotBlocked() && (
        resource.data.status == "active" ||
        resource.data.mustafhemId == request.auth.uid || 
        resource.data.mufhemId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isNotBlocked() && (
        resource.data.mustafhemId == request.auth.uid || 
        resource.data.mufhemId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // الإشعارات
    match /notifications/{notificationId} {
      allow read: if isNotBlocked() && resource.data.userId == request.auth.uid;
      allow update: if isNotBlocked() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
    }

    // الإعدادات العامة
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == "mohamed76y@gmail.com");
    }

    // طلبات السحب والتوثيق
    match /payoutRequests/{id} { allow read, write: if isAdmin(); }
    match /verificationRequests/{id} { allow read, write: if isAdmin(); }
    match /adminLogs/{id} { allow read, write: if isAdmin(); }
  }
}
