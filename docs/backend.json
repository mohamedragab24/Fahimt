
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile in the Fahmani application.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "birthDate": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["mufhem", "mustafhem"] },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "specialization": { "type": "string" },
        "bio": { "type": "string", "description": "نبذة تعريفية عن المعلم وخبراته." },
        "isVerified": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "isAdmin": { "type": "boolean" },
        "adminPermissions": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "phoneNumber", "role"]
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["main", "sub", "option"] },
        "parentId": { "type": "string", "description": "ID of the parent category if any." },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Request": {
      "title": "Request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "categorySub": { "type": "string" },
        "categoryOption": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed", "canceled"] },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentPhone": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "teacherPhone": { "type": "string" },
        "teacherSpecialization": { "type": "string" },
        "meetingTime": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "attachmentUrl": { "type": "string" },
        "rating": { "type": "number" },
        "review": { "type": "string" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "payment", "earning"] },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "adminReply": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastUpdate": { "type": "string" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "landingBg": { "type": "string", "format": "uri" },
        "logoUrl": { "type": "string", "format": "uri" },
        "miniIconUrl": { "type": "string", "format": "uri" },
        "studentHero": { "type": "string", "format": "uri" },
        "teacherHero": { "type": "string", "format": "uri" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions for a user."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Learning categories."
    },
    "/requests/{requestId}": {
      "schema": "Request",
      "description": "Learning session requests."
    },
    "/requests/{requestId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages for a specific request."
    },
    "/supportTickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets for user issues."
    },
    "/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "Global application settings and asset links."
    }
  }
}
