
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile in the Fahmani application.",
      "properties": {
        "id": { "type": "string", "description": "Unique Firebase UID" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "birthDate": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["mufhem", "mustafhem"] },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "isVerified": { "type": "boolean", "default": false },
        "status": { "type": "string", "enum": ["active", "blocked"], "default": "active" },
        "isAdmin": { "type": "boolean", "default": false, "description": "Global admin toggle" },
        "adminPermissions": { 
          "type": "array", 
          "items": { "type": "string", "enum": ["finance", "support", "moderator", "superadmin"] },
          "description": "Specific admin capabilities"
        }
      },
      "required": ["id", "fullName", "email", "phoneNumber", "birthDate", "role"]
    },
    "Request": {
      "title": "Request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed", "canceled"] },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "meetingTime": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "rating": { "type": "number" },
        "review": { "type": "string" }
      }
    },
    "VerificationRequest": {
      "title": "VerificationRequest",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "AdminLog": {
      "title": "AdminLog",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "action": { "type": "string" },
        "targetUserId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "UserProfile", "description": "User profiles and their private data." }
      },
      {
        "path": "/users/{userId}/transactions/{txId}",
        "definition": { "schema": "Transaction", "description": "Wallet history sub-collection." }
      },
      {
        "path": "/requests/{requestId}",
        "definition": { "entityName": "Request", "description": "Learning session requests." }
      },
      {
        "path": "/verificationRequests/{requestId}",
        "definition": { "entityName": "VerificationRequest", "description": "Queue for verified badge requests." }
      },
      {
        "path": "/adminLogs/{logId}",
        "definition": { "entityName": "AdminLog", "description": "Audit trail for admin actions." }
      }
    ]
  }
}
