
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile in the Fahmani application.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "birthDate": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["mufhem", "mustafhem", "admin"] },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "isAdmin": { "type": "boolean" },
        "adminPermissions": { 
          "type": "array", 
          "items": { "type": "string", "enum": ["finance", "support", "moderator", "superadmin"] } 
        }
      },
      "required": ["id", "fullName", "email", "phoneNumber", "birthDate", "role"]
    },
    "VerificationRequest": {
      "title": "VerificationRequest",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "idCardUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AdminLog": {
      "title": "AdminLog",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "action": { "type": "string" },
        "targetUserId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "UserProfile", "description": "User profile silos." }
      },
      {
        "path": "/requests/{requestId}",
        "definition": { "entityName": "Request", "description": "Global requests collection." }
      },
      {
        "path": "/verificationRequests/{requestId}",
        "definition": { "entityName": "VerificationRequest", "description": "Verification center queue." }
      },
      {
        "path": "/supportTickets/{ticketId}",
        "definition": { "entityName": "SupportTicket", "description": "User support complaints." }
      },
      {
        "path": "/adminLogs/{logId}",
        "definition": { "entityName": "AdminLog", "description": "Audit trail for admin actions." }
      }
    ]
  }
}
