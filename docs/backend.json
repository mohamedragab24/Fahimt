
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "يمثل الملف الشخصي للمستخدم في منصة فهمني.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "birthDate": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["mufhem", "mustafhem"] },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "isProfileApproved": { "type": "boolean", "description": "هل تم اعتماد الصورة والبيانات من الإدارة." },
        "specialization": { "type": "string" },
        "bio": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "role", "gender"]
    },
    "Istifham": {
      "title": "Istifham",
      "type": "object",
      "description": "يمثل استفهام (طلب تعليمي) مقدم من مستفهم.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "categorySub": { "type": "string" },
        "categoryOption": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_approval", "active", "accepted", "completed", "canceled"] },
        "mustafhemId": { "type": "string" },
        "mustafhemName": { "type": "string" },
        "mufhemId": { "type": "string" },
        "mufhemName": { "type": "string" },
        "meetingTime": { "type": "string", "format": "date-time" },
        "attachmentUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "PortfolioItem": {
      "title": "PortfolioItem",
      "type": "object",
      "description": "عمل من أعمال المفهمين.",
      "properties": {
        "id": { "type": "string" },
        "mufhemId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "type": "object",
      "description": "إعدادات المنصة والهوية البصرية.",
      "properties": {
        "siteTitle": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "footerText": { "type": "string" },
        "primaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "logoUrl": { "type": "string" },
        "miniIconUrl": { "type": "string" },
        "landingBg": { "type": "string" },
        "studentHero": { "type": "string" },
        "teacherHero": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "ملفات المستخدمين."
    },
    "/istifhams/{istifhamId}": {
      "schema": "Istifham",
      "description": "الاستفهامات التعليمية."
    },
    "/portfolio/{itemId}": {
      "schema": "PortfolioItem",
      "description": "أأعمال المفهمين."
    },
    "/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "إعدادات المنصة."
    }
  }
}
