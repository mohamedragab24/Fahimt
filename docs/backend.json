
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile in the Fahmani application.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "birthDate": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["mufhem", "mustafhem"] },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "specialization": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "isAdmin": { "type": "boolean" },
        "adminPermissions": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "phoneNumber", "role"]
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Request": {
      "title": "Request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed", "canceled"] },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "teacherSpecialization": { "type": "string" },
        "meetingTime": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "attachmentUrl": { "type": "string" },
        "rating": { "type": "number" },
        "review": { "type": "string" }
      }
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "payment", "earning"] },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "PayoutRequest": {
      "title": "PayoutRequest",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "transactionId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "VerificationRequest": {
      "title": "VerificationRequest",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "profilePictureUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions for a user."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Learning categories."
    },
    "/requests/{requestId}": {
      "schema": "Request",
      "description": "Learning session requests."
    },
    "/requests/{requestId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages for a specific request."
    },
    "/supportTickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets for user issues."
    },
    "/payoutRequests/{payoutId}": {
      "schema": "PayoutRequest",
      "description": "Withdrawal requests from teachers."
    },
    "/verificationRequests/{verId}": {
      "schema": "VerificationRequest",
      "description": "Account verification requests."
    }
  }
}
