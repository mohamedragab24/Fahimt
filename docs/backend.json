
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile in the Fahmani application.",
      "properties": {
        "id": { "type": "string", "description": "Unique Firebase UID" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "birthDate": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["mufhem", "mustafhem"] },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "specialization": { "type": "string", "description": "Teacher's specialization" },
        "isVerified": { "type": "boolean", "default": false },
        "status": { "type": "string", "enum": ["active", "blocked"], "default": "active" },
        "isAdmin": { "type": "boolean", "default": false },
        "adminPermissions": { 
          "type": "array", 
          "items": { "type": "string", "enum": ["finance", "support", "moderator", "superadmin"] }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "phoneNumber", "birthDate", "role"]
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Request": {
      "title": "Request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "completed", "canceled"] },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "meetingTime": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "rating": { "type": "number" },
        "review": { "type": "string" },
        "attachmentUrl": { "type": "string" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "replied", "closed"], "default": "open" },
        "category": { "type": "string", "enum": ["finance", "technical", "other"] },
        "adminReply": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUpdate": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "UserProfile", "description": "User profiles." }
      },
      {
        "path": "/categories/{categoryId}",
        "definition": { "entityName": "Category", "description": "Learning categories." }
      },
      {
        "path": "/requests/{requestId}",
        "definition": { "entityName": "Request", "description": "Learning session requests." }
      },
      {
        "path": "/requests/{requestId}/messages/{messageId}",
        "definition": { "entityName": "ChatMessage", "description": "Messages between student and teacher." }
      },
      {
        "path": "/supportTickets/{ticketId}",
        "definition": { "entityName": "SupportTicket", "description": "Support tickets." }
      }
    ]
  }
}
