
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "يمثل الملف الشخصي للمستخدم في منصة فهمني.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "birthDate": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["mufhem", "mustafhem"] },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "isProfileApproved": { "type": "boolean", "description": "هل تم اعتماد الصورة والبيانات من الإدارة." },
        "specialization": { "type": "string" },
        "bio": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "banReason": { "type": "string", "description": "سبب حظر الحساب إن وجد." },
        "bannedAt": { "type": "string", "format": "date-time" },
        "bannedBy": { "type": "string", "description": "الجهة التي قامت بالحظر (system أو admin)." },
        "isAdmin": { "type": "boolean" },
        "password": { "type": "string", "description": "كلمة المرور المحفوظة (لأغراض الإدارة فقط)." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "role", "gender"]
    },
    "Istifham": {
      "title": "Istifham",
      "type": "object",
      "description": "يمثل استفهام (طلب تعليمي) مقدم من مستفهم.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "categorySub": { "type": "string" },
        "categoryOption": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_approval", "active", "accepted", "completed", "canceled"] },
        "mustafhemId": { "type": "string" },
        "mustafhemName": { "type": "string" },
        "mustafhemGender": { "type": "string" },
        "mufhemId": { "type": "string" },
        "mufhemName": { "type": "string" },
        "meetingTime": { "type": "string", "format": "date-time" },
        "attachmentUrl": { "type": "string" },
        "recordingUrl": { "type": "string", "description": "رابط تسجيل المحاضرة صوت وصورة." },
        "rating": { "type": "number" },
        "review": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Job": {
      "title": "Job",
      "type": "object",
      "description": "يمثل فرصة وظيفية في المنصة.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "string" },
        "type": { "type": "string", "enum": ["full-time", "part-time", "project"] },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AppSettings": {
      "title": "AppSettings",
      "type": "object",
      "description": "إعدادات المنصة والهوية البصرية والأصول.",
      "properties": {
        "siteTitle": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "footerText": { "type": "string" },
        "primaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "logoUrl": { "type": "string" },
        "miniIconUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "splashImageUrl": { "type": "string" },
        "landingBg": { "type": "string" },
        "studentHero": { "type": "string" },
        "teacherHero": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "ملفات المستخدمين."
    },
    "/istifhams/{istifhamId}": {
      "schema": "Istifham",
      "description": "الاستفهامات التعليمية."
    },
    "/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "إعدادات المنصة."
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "فرص العمل المتاحة."
    }
  }
}
