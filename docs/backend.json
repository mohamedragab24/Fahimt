
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile in the Fahmani application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user profile."
        },
        "fullName": {
          "type": "string",
          "description": "The full name of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        },
        "phoneNumber": {
          "type": "string",
          "description": "The user's phone number (WhatsApp)."
        },
        "birthDate": {
          "type": "string",
          "description": "The user's date of birth.",
          "format": "date-time"
        },
        "role": {
          "type": "string",
          "description": "The user's role (either 'mufhem' or 'mustafhem')."
        },
        "profilePictureUrl": {
          "type": "string",
          "description": "URL of the user's profile picture.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "fullName",
        "email",
        "phoneNumber",
        "birthDate",
        "role"
      ]
    },
    "Request": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Request",
      "type": "object",
      "description": "Represents a learning request in the Fahmani application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the request."
        },
        "studentId": {
          "type": "string",
          "description": "Reference to UserProfile (Mustafhem)."
        },
        "studentName": {
          "type": "string",
          "description": "Name of the student for quick display."
        },
        "teacherId": {
          "type": "string",
          "description": "Reference to UserProfile (Mufhem). Can be null if pending."
        },
        "title": {
          "type": "string",
          "description": "The title of the request."
        },
        "amount": {
          "type": "number",
          "description": "The amount offered for the request."
        },
        "meetingTime": {
          "type": "string",
          "description": "The requested meeting time.",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "The status of the request (pending, accepted, completed, canceled)."
        },
        "category": {
          "type": "string",
          "description": "The category (study, tech, skills)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "studentId",
        "title",
        "amount",
        "status",
        "category",
        "createdAt"
      ]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Represents a financial transaction.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the transaction."
        },
        "userId": {
          "type": "string",
          "description": "Reference to UserProfile."
        },
        "amount": {
          "type": "number",
          "description": "The amount of the transaction."
        },
        "type": {
          "type": "string",
          "description": "The type (deposit, withdrawal, earning, payment)."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "amount",
        "type",
        "timestamp"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "User profile silos."
        }
      },
      {
        "path": "/requests/{requestId}",
        "definition": {
          "entityName": "Request",
          "schema": {
            "$ref": "#/backend/entities/Request"
          },
          "description": "Global requests collection for marketplace."
        }
      },
      {
        "path": "/users/{userId}/transactions/{transactionId}",
        "definition": {
          "entityName": "Transaction",
          "schema": {
            "$ref": "#/backend/entities/Transaction"
          },
          "description": "Private financial records."
        }
      }
    ]
  }
}
